{
  "doctype": "DocType",
  "name": "Payment Hub Settings",
  "module": "ERPNext Payment Hub",
  "issingle": 1,
  "editable_grid": 1,
  "track_changes": 1,
  "field_order": [
    "default_provider",
    "force_original_payment_method_refund",
    "allow_partial_refund",
    "verify_by_status_api",
    "auto_reconcile",
    "pos_section",
    "online_provider",
    "physical_terminal_provider",
    "cash_mode_of_payment",
    "physical_mode_of_payment",
    "electronic_mode_of_payment",
    "whatsapp_integration",
    "async_electronic_payment",
    "after_electronic_capture",
    "payment_link_expiry_minutes"
  ],
  "fields": [
    {
      "fieldname": "default_provider",
      "label": "Default Provider",
      "fieldtype": "Link",
      "options": "Payment Provider Account"
    },
    {
      "fieldname": "force_original_payment_method_refund",
      "label": "Force Original Provider for Refund",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "allow_partial_refund",
      "label": "Allow Partial Refund",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "verify_by_status_api",
      "label": "Verify Webhooks with Status API",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "auto_reconcile",
      "label": "Auto Reconcile",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "pos_section",
      "label": "POS Integration",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "online_provider",
      "label": "Online / WhatsApp Payment Provider",
      "fieldtype": "Link",
      "options": "Payment Provider Account"
    },
    {
      "fieldname": "physical_terminal_provider",
      "label": "Physical Terminal Provider",
      "fieldtype": "Link",
      "options": "Payment Provider Account"
    },
    {
      "fieldname": "cash_mode_of_payment",
      "label": "Cash Mode of Payment",
      "fieldtype": "Data",
      "default": "Cash"
    },
    {
      "fieldname": "physical_mode_of_payment",
      "label": "Physical Terminal Mode of Payment",
      "fieldtype": "Data",
      "default": "Physical Payment Terminal"
    },
    {
      "fieldname": "electronic_mode_of_payment",
      "label": "Electronic Payment Mode of Payment",
      "fieldtype": "Data",
      "default": "Electronic Payment"
    },
    {
      "fieldname": "whatsapp_integration",
      "label": "WhatsApp Integration",
      "fieldtype": "Select",
      "options": "Frappe WhatsApp\nMeta WhatsApp Cloud API",
      "default": "Frappe WhatsApp"
    },
    {
      "fieldname": "async_electronic_payment",
      "label": "Save Electronic Payment and Serve Next Customer",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "after_electronic_capture",
      "label": "After Electronic Payment Capture",
      "fieldtype": "Select",
      "options": "Mark Paid Only\nAuto Submit Invoice\nAuto Submit + Print Queue",
      "default": "Mark Paid Only"
    },
    {
      "fieldname": "payment_link_expiry_minutes",
      "label": "Payment Link / Pending Sale Expiry (Minutes)",
      "fieldtype": "Int",
      "default": "30"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}