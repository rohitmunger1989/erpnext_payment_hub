{
  "doctype": "DocType",
  "name": "Payment Hub Settings",
  "module": "ERPNext Payment Hub",
  "issingle": 1,
  "editable_grid": 1,
  "track_changes": 1,
  "field_order": [
    "default_provider",
    "force_original_payment_method_refund",
    "allow_partial_refund",
    "verify_by_status_api",
    "auto_reconcile",
    "pos_section",
    "online_provider",
    "physical_terminal_provider",
    "cash_mode_of_payment",
    "physical_mode_of_payment",
    "electronic_mode_of_payment",
    "whatsapp_integration",
    "whatsapp_account_name",
    "whatsapp_template_name",
    "whatsapp_sender_method",
    "payment_link_message_template",
    "async_electronic_payment",
    "after_electronic_capture",
    "default_print_format",
    "payment_link_expiry_minutes",
    "auto_expire_pending_sales",
    "refund_security_section",
    "require_authorization_cash_refund",
    "require_authorization_electronic_refund",
    "require_authorization_physical_refund",
    "allow_refund_method_override",
    "refund_authorization_minutes"
  ],
  "fields": [
    {
      "fieldname": "default_provider",
      "label": "Default Provider",
      "fieldtype": "Link",
      "options": "Payment Provider Account"
    },
    {
      "fieldname": "force_original_payment_method_refund",
      "label": "Force Original Provider for Refund",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "allow_partial_refund",
      "label": "Allow Partial Refund",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "verify_by_status_api",
      "label": "Verify Webhooks with Status API",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "auto_reconcile",
      "label": "Auto Reconcile",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "pos_section",
      "label": "POS Integration",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "online_provider",
      "label": "Online / WhatsApp Payment Provider",
      "fieldtype": "Link",
      "options": "Payment Provider Account"
    },
    {
      "fieldname": "physical_terminal_provider",
      "label": "Physical Terminal Provider",
      "fieldtype": "Link",
      "options": "Payment Provider Account"
    },
    {
      "fieldname": "cash_mode_of_payment",
      "label": "Cash Mode of Payment",
      "fieldtype": "Data",
      "default": "Cash"
    },
    {
      "fieldname": "physical_mode_of_payment",
      "label": "Physical Terminal Mode of Payment",
      "fieldtype": "Data",
      "default": "Physical Payment Terminal"
    },
    {
      "fieldname": "electronic_mode_of_payment",
      "label": "Electronic Payment Mode of Payment",
      "fieldtype": "Data",
      "default": "Electronic Payment"
    },
    {
      "fieldname": "whatsapp_integration",
      "label": "WhatsApp Integration",
      "fieldtype": "Select",
      "options": "Frappe WhatsApp\nMeta WhatsApp Cloud API",
      "default": "Frappe WhatsApp"
    },
    {
      "fieldname": "async_electronic_payment",
      "label": "Save Electronic Payment and Serve Next Customer",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "after_electronic_capture",
      "label": "After Electronic Payment Capture",
      "fieldtype": "Select",
      "options": "Mark Paid Only\nAuto Submit Invoice\nAuto Submit + Print Queue",
      "default": "Mark Paid Only"
    },
    {
      "fieldname": "payment_link_expiry_minutes",
      "label": "Payment Link / Pending Sale Expiry (Minutes)",
      "fieldtype": "Int",
      "default": "30"
    },
    {
      "fieldname": "whatsapp_account_name",
      "label": "WhatsApp Account (Optional)",
      "fieldtype": "Data",
      "description": "Name of the outgoing WhatsApp Account in frappe_whatsapp. Leave blank to use its default outgoing account."
    },
    {
      "fieldname": "whatsapp_template_name",
      "label": "Payment Link WhatsApp Template",
      "fieldtype": "Data",
      "description": "Optional approved frappe_whatsapp template. Recommended when initiating a conversation outside Meta's 24-hour service window."
    },
    {
      "fieldname": "whatsapp_sender_method",
      "label": "Custom WhatsApp Sender Method",
      "fieldtype": "Data",
      "description": "Optional dotted Python method. Called with to, message, reference_doctype, reference_name, allocation and session."
    },
    {
      "fieldname": "payment_link_message_template",
      "label": "Payment Link Message Template",
      "fieldtype": "Small Text",
      "default": "Payment request {session}\nAmount: {currency} {amount}\nPlease complete your payment using the secure link below:\n{payment_url}"
    },
    {
      "fieldname": "default_print_format",
      "label": "Default POS Print Format",
      "fieldtype": "Data",
      "default": "Standard"
    },
    {
      "fieldname": "auto_expire_pending_sales",
      "label": "Auto Expire Stale Pending Sales",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "refund_security_section",
      "label": "Refund Security",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "require_authorization_cash_refund",
      "label": "Require Manager Authorization for Cash Refund",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "require_authorization_electronic_refund",
      "label": "Require Manager Authorization for Electronic Refund",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "require_authorization_physical_refund",
      "label": "Require Manager Authorization for Physical Terminal Refund",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "allow_refund_method_override",
      "label": "Allow Authorized Refund Method Override",
      "fieldtype": "Check",
      "default": "1",
      "description": "Requires Payment Hub Refund Override role and manager/admin password. v0.5.0 permits override to the configured Cash Mode of Payment only."
    },
    {
      "fieldname": "refund_authorization_minutes",
      "label": "Refund Authorization Validity (Minutes)",
      "fieldtype": "Int",
      "default": "5"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
